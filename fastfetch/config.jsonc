{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/assets/logo_green.png",
    "type": "kitty",
    "padding": {
      "top": 0,
      "left": 1
    },
    "width": 24,
    "height": 20
  },
  "display": {
    "separator": " ",
    "color": "green"
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;5;46m ╔✦ root@matrix ✦╗"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;46m ╚═══════════════╝"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;5;46m ┌✦ SYSTEM ──────┐"
    },
    {
      "type": "user",
      "key": "\u001b[38;5;46m │ user  "
    },
    {
      "type": "os",
      "key": "\u001b[38;5;46m │ 󰣇 os    "
    },
    {
      "type": "kernel",
      "key": "\u001b[38;5;46m │ kern  "
    },
    {
      "type": "uptime",
      "key": "\u001b[38;5;46m │ up    "
    },
    {
      "type": "wm",
      "key": "\u001b[38;5;46m │ wm    "
    },
    {
      "type": "shell",
      "key": "\u001b[38;5;46m │ shell "
    },
    {
      "type": "packages",
      "key": "\u001b[38;5;46m │ pkgs  "
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;46m ├✦ HARDWARE ────┤"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;5;46m │ cpu   "
    },
    {
      "type": "gpu",
      "key": "\u001b[38;5;46m │ 󱤓 gpu   "
    },
    {
      "type": "memory",
      "key": "\u001b[38;5;46m │ ram   "
    },
    {
      "type": "disk",
      "key": "\u001b[38;5;46m │ disk  "
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;46m └──────────────────────┘\u001b[0m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block"
    },
    "break"
  ]
}
